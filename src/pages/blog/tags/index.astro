---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
const posts = await getCollection('blog', ({ data }) => !data.draft);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
const countFor = (tag) => posts.filter((post) => post.data.tags.includes(tag)).length;
---
<Base title="Blog tags" description="Browse Daniel Marcinkowski's blog posts by tag.">
  <h1 class="text-4xl font-bold">Blog tags</h1>
  <p class="mt-3 text-zinc-700 dark:text-zinc-300">Browse writing by topic.</p>
  <div class="mt-8 flex flex-wrap gap-3">
    {tags.map((tag) => <a class="tag-link rounded-full border border-zinc-200 px-4 py-2 dark:border-zinc-800" href={`/blog/tags/${tag.toLowerCase().replaceAll(' ', '-')}/`}>{tag} <span class="text-zinc-500">{countFor(tag)}</span></a>)}
  </div>
</Base>
