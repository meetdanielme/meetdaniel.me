---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getImageMetadata } from "../../utils/image-metadata";
import { getEntrySlug } from "../../utils/content";
import { getFeaturedImage } from "../../utils/images";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
    title="Blog"
    description="Writing by Daniel Marcinkowski about technology, productivity, marketing, university, and personal systems."
>
    <h1 class="text-4xl font-bold">Blog</h1>
    <p class="mt-3 text-zinc-700 dark:text-zinc-300">
        Notes and essays on technology, productivity, marketing, university, and
        trying to use the internet more intentionally.
    </p>
    <div class="mt-10 grid gap-8">
        {
            posts.map((post) => {
                const featuredImage = getFeaturedImage(post);
                const featuredImageMetadata = getImageMetadata(featuredImage);
                return (
                    <article
                        class={`post-card ${featuredImage ? "with-image" : ""}`}
                    >
                        {featuredImage && (
                            <a href={`/blog/${getEntrySlug(post)}/`}>
                                <img
                                    class="post-thumb"
                                    src={featuredImage}
                                    alt=""
                                    width={featuredImageMetadata?.width}
                                    height={featuredImageMetadata?.height}
                                    loading="lazy"
                                    decoding="async"
                                />
                            </a>
                        )}
                        <div>
                            <p class="text-sm text-zinc-600 dark:text-zinc-400">
                                {post.data.pubDate.toLocaleDateString("en-GB", {
                                    dateStyle: "long",
                                })}
                            </p>
                            <h2 class="mt-1 text-2xl font-bold">
                                <a
                                    class="post-title-link"
                                    href={`/blog/${getEntrySlug(post)}/`}
                                >
                                    {post.data.title}
                                </a>
                            </h2>
                            {post.data.description && (
                                <p class="mt-2">{post.data.description}</p>
                            )}
                            <div class="mt-3 flex flex-wrap gap-2">
                                {post.data.tags.map((tag) => (
                                    <a
                                        class="tag-link rounded-full bg-brand-code px-3 py-1 text-xs text-black"
                                        href={`/blog/tags/${tag.toLowerCase().replaceAll(" ", "-")}/`}
                                    >
                                        {tag}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </article>
                );
            })
        }
    </div>
</Base>
