---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { getImageMetadata } from "../utils/image-metadata";
import { getEntrySlug } from "../utils/content";
import { getFeaturedImage } from "../utils/images";
import RightNowPreview from "../components/RightNowPreview.astro";
import {
    buildRightNowPermalinkMap,
    getRightNowPermalinkSlug,
} from "../utils/right-now";
import { getPublishedRightNowPosts } from "../utils/right-now-collection";
const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5);
const rightNowPosts = await getPublishedRightNowPosts();
const rightNowPermalinkMap = buildRightNowPermalinkMap(rightNowPosts);
const latestRightNowPost = rightNowPosts[0];
const latestRightNowPermalink = latestRightNowPost
    ? getRightNowPermalinkSlug(latestRightNowPost, rightNowPermalinkMap)
    : undefined;

const getCardImage = (src: string) => {
    const resizedSrc = src.replace(/(\.[^.]+)$/, "-800$1");
    const resizedMetadata = getImageMetadata(resizedSrc);
    const originalMetadata = getImageMetadata(src);

    return {
        src: resizedMetadata ? resizedSrc : src,
        metadata: resizedMetadata ?? originalMetadata,
        srcset:
            resizedMetadata && originalMetadata
                ? `${resizedSrc} 800w, ${src} ${originalMetadata.width}w`
                : undefined,
    };
};
---

<Base>
    <section class="border-l-2 border-brand-gold pl-8">
        <h1 class="text-4xl font-bold leading-tight">Meet, Daniel (me)</h1>
        <p class="mt-6 text-base">
            Cześć! I’m <a class="font-bold" href="/about/"
                >Daniel Marcinkowski</a
            >, a marketer with 10 years of experience and Business Information
            Systems student at University College Cork.
        </p>
        <p class="mt-4">
            On this website, I explore how I use technology to be creative,
            productive, and healthy — with a soft spot for humane tech,
            thoughtful systems, and life as a mature student.
        </p>
    </section>
    <hr class="my-10 border-zinc-200 dark:border-zinc-800" />
    {latestRightNowPost && latestRightNowPermalink && (
        <RightNowPreview
            post={latestRightNowPost}
            permalink={latestRightNowPermalink}
        />
    )}
    {
        latestRightNowPost && (
            <hr class="my-10 border-zinc-200 dark:border-zinc-800" />
        )
    }
    <section>
        <h2 class="text-2xl font-bold">
            <a class="section-heading-link" href="/blog/">Blog</a>
        </h2>
        <div class="mt-6 grid gap-8">
            {
                posts.map((post, index) => {
                    const featuredImage = getFeaturedImage(post);
                    const cardImage = featuredImage
                        ? getCardImage(featuredImage)
                        : undefined;
                    return (
                        <article
                            class={`post-card ${featuredImage ? "with-image" : ""}`}
                        >
                            {featuredImage && (
                                <a
                                    href={`/blog/${getEntrySlug(post)}/`}
                                    aria-label={`Read ${post.data.title}`}
                                >
                                    <img
                                        class="post-thumb"
                                        src={cardImage?.src}
                                        srcset={cardImage?.srcset}
                                        sizes="(min-width: 768px) 364px, calc(100vw - 48px)"
                                        alt=""
                                        width={cardImage?.metadata?.width}
                                        height={cardImage?.metadata?.height}
                                        loading={index === 0 ? "eager" : "lazy"}
                                        decoding="async"
                                        fetchpriority={
                                            index === 0 ? "high" : undefined
                                        }
                                    />
                                </a>
                            )}
                            <div>
                                <p class="text-sm text-zinc-600 dark:text-zinc-400">
                                    {post.data.pubDate.toLocaleDateString(
                                        "en-GB",
                                        {
                                            dateStyle: "long",
                                        },
                                    )}
                                </p>
                                <h3 class="mt-1 text-xl font-bold">
                                    <a
                                        class="post-title-link"
                                        href={`/blog/${getEntrySlug(post)}/`}
                                    >
                                        {post.data.title}
                                    </a>
                                </h3>
                                {post.data.description && (
                                    <p class="mt-2 text-zinc-700 dark:text-zinc-300">
                                        {post.data.description}
                                    </p>
                                )}
                                <div class="mt-3 flex flex-wrap gap-2">
                                    {post.data.tags.slice(0, 3).map((tag) => (
                                        <a
                                            class="tag-link rounded-full bg-brand-code px-3 py-1 text-xs text-black"
                                            href={`/blog/tags/${tag.toLowerCase().replaceAll(" ", "-")}/`}
                                        >
                                            {tag}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </article>
                    );
                })
            }
        </div>
        <a class="btn btn-secondary mt-8" href="/blog/">View all posts →</a>
    </section>
</Base>
