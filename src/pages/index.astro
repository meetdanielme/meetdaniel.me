---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { getFeaturedImage } from "../utils/images";
const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5);
---

<Base>
    <section class="border-l-2 border-brand-gold pl-8">
        <h1 class="text-4xl font-bold leading-tight">Meet, Daniel (me)</h1>
        <p class="mt-6 text-base">
            Cześć! I’m <a class="font-bold" href="/about/"
                >Daniel Marcinkowski</a
            >, a former startup marketer turned Business Information Systems
            student at University College Cork.
        </p>
        <p class="mt-4">
            On this website, I explore how I use technology to be creative,
            productive, and healthy — with a soft spot for humane tech,
            thoughtful systems, and life as a mature student.
        </p>
    </section>
    <hr class="my-10 border-zinc-200 dark:border-zinc-800" />
    <section>
        <h2 class="text-2xl font-bold">Recently published</h2>
        <div class="mt-6 grid gap-8">
            {
                posts.map((post) => {
                    const featuredImage = getFeaturedImage(post);
                    return (
                    <article
                        class={`post-card ${featuredImage ? "with-image" : ""}`}
                    >
                        {featuredImage && (
                            <a href={`/blog/${post.slug}/`}>
                                <img
                                    class="post-thumb"
                                    src={featuredImage}
                                    alt=""
                                    loading="lazy"
                                />
                            </a>
                        )}
                        <div>
                            <p class="text-sm text-zinc-600 dark:text-zinc-400">
                                {post.data.pubDate.toLocaleDateString("en-GB", {
                                    dateStyle: "long",
                                })}
                            </p>
                            <h3 class="mt-1 text-xl font-bold">
                                <a
                                    class="post-title-link"
                                    href={`/blog/${post.slug}/`}
                                >
                                    {post.data.title}
                                </a>
                            </h3>
                            {post.data.description && (
                                <p class="mt-2 text-zinc-700 dark:text-zinc-300">
                                    {post.data.description}
                                </p>
                            )}
                            <div class="mt-3 flex flex-wrap gap-2">
                                {post.data.tags.slice(0, 3).map((tag) => (
                                    <a
                                        class="tag-link rounded-full bg-brand-code px-3 py-1 text-xs text-black"
                                        href={`/blog/tags/${tag.toLowerCase().replaceAll(" ", "-")}/`}
                                    >
                                        {tag}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </article>
                    );
                })
            }
        </div>
        <a
            class="btn btn-secondary mt-8"
            href="/blog/">View all posts →</a
        >
    </section>
</Base>
