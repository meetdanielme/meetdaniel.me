---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,5);
---
<Base>
  <section class="border-l-2 border-brand-gold pl-8">
    <h1 class="text-4xl font-bold leading-tight">Meet, Daniel (me)</h1>
    <p class="mt-6 text-lg">Cześć! I’m <strong class="text-brand-gold">Daniel Marcinkowski</strong>, a former startup marketer turned Business Information Systems student at University College Cork.</p>
    <p class="mt-4">On this website, I explore how I use technology to be creative, productive, and healthy.</p>
    <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400">TODO: Review homepage positioning and social links.</p>
  </section>
  <hr class="my-10 border-zinc-200 dark:border-zinc-800" />
  <section>
    <h2 class="text-2xl font-bold">Recently published</h2>
    <div class="mt-6 grid gap-8">
      {posts.map((post) => <article class="border-b border-zinc-200 pb-6 dark:border-zinc-800">
        <p class="text-sm text-zinc-600 dark:text-zinc-400">{post.data.pubDate.toLocaleDateString('en-GB', { dateStyle: 'long' })}</p>
        <h3 class="mt-1 text-xl font-bold"><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
        {post.data.description && <p class="mt-2 text-zinc-700 dark:text-zinc-300">{post.data.description}</p>}
        <div class="mt-3 flex flex-wrap gap-2">{post.data.tags.slice(0,3).map((tag)=><span class="rounded-full bg-brand-code px-3 py-1 text-xs text-black">{tag}</span>)}</div>
      </article>)}
    </div>
    <a class="mt-8 inline-block rounded-lg border border-zinc-300 px-4 py-2 font-semibold dark:border-zinc-700" href="/blog/">View all posts →</a>
  </section>
</Base>
