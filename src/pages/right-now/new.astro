---
import Base from "../../layouts/Base.astro";
import { RIGHT_NOW_MAX_LENGTH } from "../../utils/right-now";
import { hasValidRightNowSession } from "../../utils/right-now-auth";

export const prerender = false;

const isAuthenticated = await hasValidRightNowSession(Astro.cookies);
const loginFailed = Astro.url.searchParams.get("error") === "1";
const isLocalPublish = import.meta.env.RIGHT_NOW_LOCAL_PUBLISH === "true";
const isMastodonConfigured = Boolean(
    import.meta.env.MASTODON_INSTANCE_URL && import.meta.env.MASTODON_ACCESS_TOKEN,
);
const isBlueskyConfigured = Boolean(
    import.meta.env.BLUESKY_HANDLE && import.meta.env.BLUESKY_APP_PASSWORD,
);
const isThreadsConfigured = Boolean(
    import.meta.env.THREADS_ACCESS_TOKEN && import.meta.env.THREADS_USER_ID,
);
const isCrossPostingConfigured =
    isMastodonConfigured || isBlueskyConfigured || isThreadsConfigured;
---

<Base
    title="Post to Right Now"
    description="Private posting page for Daniel Marcinkowski's Right Now updates."
    canonical="/right-now/new/"
    noindex={true}
>
    <section class="right-now-admin" aria-labelledby="right-now-admin-title">
        <h1 id="right-now-admin-title" class="text-4xl font-bold">
            Post to Right Now
        </h1>
        {
            isAuthenticated ? (
                <>
                    {isLocalPublish && (
                        <p class="form-help">
                            Local test mode is active. Posts and media will be
                            saved into this checkout only.
                        </p>
                    )}
                    <div class="right-now-composer-card">
                        <div class="right-now-composer-header">
                            <img
                                class="right-now-composer-avatar"
                                src="/images/profile/daniel-marcinkowski-profile-picture.jpg"
                                alt=""
                                width="48"
                                height="48"
                                loading="lazy"
                                decoding="async"
                            />
                            <div class="right-now-composer-meta">
                                <strong>Daniel Marcinkowski</strong>
                                <span>@meetdaniel.me</span>
                            </div>
                        </div>
                        <form
                            class="right-now-compose-form"
                            data-right-now-form
                            enctype="multipart/form-data"
                        >
                            <textarea
                                class="right-now-compose-textarea"
                                id="right-now-text"
                                name="text"
                                maxlength={RIGHT_NOW_MAX_LENGTH}
                                rows="4"
                                required
                                data-right-now-text
                                placeholder="What's on your mind?"
                            />
                            <input
                                id="right-now-media"
                                class="right-now-media-input"
                                name="media"
                                type="file"
                                accept="image/*,video/*"
                                multiple
                                data-right-now-media-input
                            />
                            <ul
                                class="right-now-media-list"
                                data-right-now-media-list
                                hidden
                            ></ul>
                            <textarea
                                id="right-now-alt"
                                name="altText"
                                data-right-now-alt-store
                                hidden
                            ></textarea>
                            <div class="right-now-location-input">
                                <input
                                    id="right-now-location"
                                    name="location"
                                    type="text"
                                    maxlength="120"
                                    placeholder="City, Country"
                                    data-right-now-location
                                />
                                <button
                                    class="icon-button"
                                    type="button"
                                    aria-label="Use current location"
                                    title="Use current location"
                                    data-right-now-location-button
                                >
                                    <i class="ri-map-pin-line" aria-hidden="true"></i>
                                </button>
                            </div>
                            <p
                                class="form-help right-now-location-status"
                                data-right-now-location-status
                            ></p>
                            <div class="right-now-compose-toolbar">
                                <div class="right-now-compose-actions">
                                    <button
                                        class="right-now-tool-button right-now-icon-tool-button"
                                        type="button"
                                        aria-label="Add media"
                                        title="Add media"
                                        data-right-now-media-button
                                    >
                                        <i
                                            class="ri-image-add-line"
                                            aria-hidden="true"
                                        ></i>
                                    </button>
                                    <label
                                        class:list={[
                                            "right-now-social-toggle",
                                            {
                                                "right-now-social-toggle-disabled":
                                                    !isMastodonConfigured,
                                            },
                                        ]}
                                        aria-label="Cross-post to Mastodon"
                                        title="Cross-post to Mastodon"
                                    >
                                        <input
                                            class="sr-only"
                                            type="checkbox"
                                            name="crosspostMastodon"
                                            checked={isMastodonConfigured}
                                            disabled={!isMastodonConfigured}
                                        />
                                        <i
                                            class="ri-mastodon-fill"
                                            aria-hidden="true"
                                        ></i>
                                    </label>
                                    <label
                                        class:list={[
                                            "right-now-social-toggle",
                                            {
                                                "right-now-social-toggle-disabled":
                                                    !isThreadsConfigured,
                                            },
                                        ]}
                                        aria-label="Cross-post to Threads"
                                        title="Cross-post to Threads"
                                    >
                                        <input
                                            class="sr-only"
                                            type="checkbox"
                                            name="crosspostThreads"
                                            checked={isThreadsConfigured}
                                            disabled={!isThreadsConfigured}
                                        />
                                        <i
                                            class="ri-threads-fill"
                                            aria-hidden="true"
                                        ></i>
                                    </label>
                                    <label
                                        class:list={[
                                            "right-now-social-toggle",
                                            {
                                                "right-now-social-toggle-disabled":
                                                    !isBlueskyConfigured,
                                            },
                                        ]}
                                        aria-label="Cross-post to Bluesky"
                                        title="Cross-post to Bluesky"
                                    >
                                        <input
                                            class="sr-only"
                                            type="checkbox"
                                            name="crosspostBluesky"
                                            checked={isBlueskyConfigured}
                                            disabled={!isBlueskyConfigured}
                                        />
                                        <i
                                            class="ri-bluesky-fill"
                                            aria-hidden="true"
                                        ></i>
                                    </label>
                                </div>
                                <div class="right-now-compose-actions">
                                    <span class="right-now-character-count">
                                        <span data-right-now-count>0</span>/
                                        {RIGHT_NOW_MAX_LENGTH}
                                    </span>
                                    <button class="btn btn-primary" type="submit">
                                        Post
                                    </button>
                                </div>
                            </div>
                            {!isCrossPostingConfigured && (
                                <p class="form-help">
                                    Add social platform environment variables to
                                    enable cross-posting.
                                </p>
                            )}
                            <p class="form-status" data-right-now-status></p>
                        </form>
                    </div>
                    <form method="post" action="/api/right-now/session/">
                        <input type="hidden" name="action" value="logout" />
                        <button class="btn btn-secondary" type="submit">
                            Log out
                        </button>
                    </form>
                </>
            ) : (
                <form
                    class="right-now-form"
                    method="post"
                    action="/api/right-now/session/"
                >
                    <label for="right-now-secret">Posting secret</label>
                    <input
                        id="right-now-secret"
                        name="secret"
                        type="password"
                        autocomplete="current-password"
                        required
                    />
                    {loginFailed && (
                        <p class="form-error">That secret was not accepted.</p>
                    )}
                    <button class="btn btn-primary" type="submit">
                        <i class="ri-lock-unlock-line" aria-hidden="true"></i>
                        Continue
                    </button>
                </form>
            )
        }
    </section>
    {
        isAuthenticated && (
            <script>
                const form = document.querySelector<HTMLFormElement>(
                    "[data-right-now-form]",
                );
                const text = document.querySelector<HTMLTextAreaElement>(
                    "[data-right-now-text]",
                );
                const count = document.querySelector("[data-right-now-count]");
                const status = document.querySelector<HTMLElement>(
                    "[data-right-now-status]",
                );
                const mediaInput = document.querySelector<HTMLInputElement>(
                    "[data-right-now-media-input]",
                );
                const mediaButton = document.querySelector<HTMLButtonElement>(
                    "[data-right-now-media-button]",
                );
                const mediaList = document.querySelector<HTMLElement>(
                    "[data-right-now-media-list]",
                );
                const altTextStore = document.querySelector<HTMLTextAreaElement>(
                    "[data-right-now-alt-store]",
                );
                const locationInput = document.querySelector<HTMLInputElement>(
                    "[data-right-now-location]",
                );
                const locationButton = document.querySelector<HTMLButtonElement>(
                    "[data-right-now-location-button]",
                );
                const locationStatus = document.querySelector<HTMLElement>(
                    "[data-right-now-location-status]",
                );
                const maxFiles = 4;
                let altTexts: string[] = [];

                const syncAltTextStore = () => {
                    if (!altTextStore) return;
                    altTextStore.value = altTexts.join("\n");
                };

                const updateCount = () => {
                    if (!text || !count) return;
                    count.textContent = String(
                        Array.from(text.value.trim()).length,
                    );
                };

                const setStatus = (message: string, isError = false) => {
                    if (!status) return;
                    status.textContent = message;
                    status.classList.toggle("form-error", isError);
                };

                const renderMediaList = () => {
                    if (!mediaList || !mediaInput) return;
                    const files = Array.from(mediaInput.files || []);

                    mediaList.innerHTML = "";
                    mediaList.hidden = files.length === 0;
                    altTexts = files.map((_, index) => altTexts[index] || "");
                    syncAltTextStore();

                    files.forEach((file, index) => {
                        const item = document.createElement("li");
                        item.className = "right-now-media-item";

                        const name = document.createElement("span");
                        name.className = "right-now-media-name";

                        const icon = document.createElement("i");
                        icon.className = file.type.startsWith("video/")
                            ? "ri-movie-line"
                            : "ri-image-line";
                        icon.setAttribute("aria-hidden", "true");

                        const textLabel = document.createElement("span");
                        textLabel.textContent = file.name;

                        name.append(icon, textLabel);

                        const removeButton = document.createElement("button");
                        removeButton.className = "right-now-media-remove";
                        removeButton.type = "button";
                        removeButton.dataset.rightNowMediaRemoveIndex =
                            String(index);
                        removeButton.setAttribute(
                            "aria-label",
                            `Remove ${file.name}`,
                        );
                        removeButton.innerHTML =
                            '<i class="ri-close-line" aria-hidden="true"></i>';

                        const actions = document.createElement("span");
                        actions.className = "right-now-media-actions";

                        const altButton = document.createElement("button");
                        altButton.className = "right-now-media-alt-toggle";
                        altButton.type = "button";
                        altButton.dataset.rightNowMediaAltIndex = String(index);
                        altButton.textContent = altTexts[index]
                            ? "Edit alt"
                            : "Alt";
                        altButton.setAttribute(
                            "aria-expanded",
                            "false",
                        );

                        actions.append(altButton, removeButton);

                        const altInput = document.createElement("textarea");
                        altInput.className = "right-now-media-alt-input";
                        altInput.rows = 2;
                        altInput.hidden = true;
                        altInput.value = altTexts[index] || "";
                        altInput.placeholder = `Alt text for ${file.name}`;
                        altInput.dataset.rightNowMediaAltInput = String(index);

                        item.append(name, actions, altInput);
                        mediaList.append(item);
                    });
                };

                const mergeFiles = (incomingFiles: File[]) => {
                    if (!mediaInput) return;

                    const accepted = incomingFiles.filter(
                        (file) =>
                            file.size > 0 &&
                            (file.type.startsWith("image/") ||
                                file.type.startsWith("video/")),
                    );
                    if (accepted.length === 0) return;

                    const existing = Array.from(mediaInput.files || []);
                    const merged = [...existing, ...accepted].slice(0, maxFiles);
                    altTexts = [
                        ...altTexts.slice(0, existing.length),
                        ...accepted.map(() => ""),
                    ].slice(0, maxFiles);
                    const dataTransfer = new DataTransfer();
                    merged.forEach((file) => dataTransfer.items.add(file));
                    mediaInput.files = dataTransfer.files;
                    renderMediaList();

                    if (existing.length + accepted.length > maxFiles) {
                        setStatus(
                            `Only ${maxFiles} attachments are allowed.`,
                            true,
                        );
                        return;
                    }

                    setStatus(
                        `Added ${accepted.length} attachment${accepted.length === 1 ? "" : "s"}.`,
                    );
                };

                text?.addEventListener("input", updateCount);
                updateCount();

                mediaButton?.addEventListener("click", () =>
                    mediaInput?.click(),
                );
                mediaInput?.addEventListener("change", () => {
                    const files = Array.from(mediaInput.files || []);
                    altTexts = files.map((_, index) => altTexts[index] || "");
                    renderMediaList();
                });

                mediaList?.addEventListener("click", (event) => {
                    if (!(event.target instanceof Element) || !mediaInput) {
                        return;
                    }

                    const altButton = event.target.closest<HTMLButtonElement>(
                        "[data-right-now-media-alt-index]",
                    );
                    if (altButton) {
                        const index = Number(
                            altButton.dataset.rightNowMediaAltIndex,
                        );
                        if (Number.isNaN(index)) return;

                        const altInput = mediaList.querySelector<HTMLTextAreaElement>(
                            `[data-right-now-media-alt-input="${index}"]`,
                        );
                        if (!altInput) return;

                        altInput.hidden = !altInput.hidden;
                        altButton.setAttribute(
                            "aria-expanded",
                            String(!altInput.hidden),
                        );
                        if (!altInput.hidden) altInput.focus();
                        return;
                    }

                    const removeButton = event.target.closest<HTMLButtonElement>(
                        "[data-right-now-media-remove-index]",
                    );
                    if (!removeButton) return;

                    const index = Number(
                        removeButton.dataset.rightNowMediaRemoveIndex,
                    );
                    if (Number.isNaN(index)) return;

                    const files = Array.from(mediaInput.files || []);
                    files.splice(index, 1);
                    altTexts.splice(index, 1);

                    const dataTransfer = new DataTransfer();
                    files.forEach((file) => dataTransfer.items.add(file));
                    mediaInput.files = dataTransfer.files;
                    renderMediaList();
                });

                mediaList?.addEventListener("input", (event) => {
                    if (!(event.target instanceof HTMLTextAreaElement)) return;
                    const index = Number(
                        event.target.dataset.rightNowMediaAltInput,
                    );
                    if (Number.isNaN(index)) return;

                    altTexts[index] = event.target.value;
                    syncAltTextStore();
                });

                const handlePaste = (event: ClipboardEvent) => {
                    const clipboardFiles = Array.from(
                        event.clipboardData?.files || [],
                    );
                    if (clipboardFiles.length === 0) return;

                    const hasMedia = clipboardFiles.some(
                        (file) =>
                            file.type.startsWith("image/") ||
                            file.type.startsWith("video/"),
                    );
                    if (!hasMedia) return;

                    event.preventDefault();
                    mergeFiles(clipboardFiles);
                };

                form?.addEventListener("paste", handlePaste);

                locationButton?.addEventListener("click", () => {
                    if (!locationInput || !locationStatus) return;

                    if (!navigator.geolocation) {
                        locationStatus.textContent =
                            "Location is not available in this browser.";
                        locationStatus.classList.add("form-error");
                        return;
                    }

                    locationStatus.textContent = "Finding location...";
                    locationStatus.classList.remove("form-error");
                    locationButton.disabled = true;

                    navigator.geolocation.getCurrentPosition(
                        async (position) => {
                            const { latitude, longitude } = position.coords;

                            try {
                                const response = await fetch(
                                    `https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${latitude}&longitude=${longitude}&localityLanguage=en`,
                                );
                                const result = await response.json();
                                const city =
                                    result.city ||
                                    result.locality ||
                                    result.principalSubdivision;
                                const country = result.countryName;

                                if (!city || !country) {
                                    throw new Error("Missing location name.");
                                }

                                locationInput.value = `${city}, ${country}`;
                                locationStatus.textContent = "Location added.";
                            } catch {
                                locationStatus.textContent =
                                    "Could not turn your location into a city and country.";
                                locationStatus.classList.add("form-error");
                            } finally {
                                locationButton.disabled = false;
                            }
                        },
                        () => {
                            locationStatus.textContent =
                                "Location permission was not granted.";
                            locationStatus.classList.add("form-error");
                            locationButton.disabled = false;
                        },
                        {
                            enableHighAccuracy: false,
                            maximumAge: 10 * 60 * 1000,
                            timeout: 10000,
                        },
                    );
                });

                form?.addEventListener("submit", async (event) => {
                    event.preventDefault();
                    setStatus("Publishing...");

                    const response = await fetch("/api/right-now/create/", {
                        method: "POST",
                        body: new FormData(form),
                    });
                    const result = await response.json();

                    if (!response.ok) {
                        setStatus(result.error || "Publishing failed.", true);
                        return;
                    }

                    form.reset();
                    altTexts = [];
                    updateCount();
                    renderMediaList();
                    const warningText = Array.isArray(result.warnings)
                        ? result.warnings.join(" ")
                        : "";
                    setStatus(
                        [result.message || "Published.", warningText]
                            .filter(Boolean)
                            .join(" "),
                        Boolean(warningText),
                    );
                });
            </script>
        )
    }
</Base>
