---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { getFeaturedImage } from "../utils/images";
export async function getStaticPaths() {
    const pages = await getCollection("pages", ({ data }) => !data.draft);
    return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await page.render();
const pageFeaturedImage = getFeaturedImage(page);
const pagesWithUpdatedDate = new Set(["about", "work", "uses", "now"]);
const showUpdatedDate = pagesWithUpdatedDate.has(page.slug) && page.data.updatedDate;
const formattedUpdatedDate = page.data.updatedDate?.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
});
const caseStudies =
    page.slug === "work"
        ? (await getCollection("case-studies", ({ data }) => !data.draft)).sort(
              (a, b) =>
                  a.data.order - b.data.order ||
                  b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
          )
        : [];
---

<Base
    title={page.data.title}
    description={page.data.description ||
        `${page.data.title} page for Daniel Marcinkowski.`}
    canonical={`/${page.slug}/`}
    socialImage={pageFeaturedImage}
>
    <article>
        <h1
            class={`text-4xl font-bold ${showUpdatedDate || page.data.heroImage ? "mb-3" : "mb-8"}`}
        >
            {page.data.title}
        </h1>
        {
            showUpdatedDate && (
                <p class="page-updated">Last updated: {formattedUpdatedDate}</p>
            )
        }
        {
            page.data.heroImage && (
                <img
                    class="page-hero-image"
                    src={page.data.heroImage}
                    alt=""
                    loading="eager"
                />
            )
        }
        <div class="prose prose-zinc dark:prose-invert"><Content /></div>
    </article>
    {
        page.slug === "work" && caseStudies.length > 0 && (
            <section class="case-section">
                <h2 class="text-2xl font-bold">Case studies</h2>
                <div class="case-list">
                    {caseStudies.map((study) => {
                        const featuredImage = getFeaturedImage(study);
                        return (
                            <article
                                class={`post-card ${featuredImage ? "with-image" : ""}`}
                            >
                                {featuredImage && (
                                    <a href={`/work/${study.slug}/`}>
                                        <img
                                            class="post-thumb"
                                            src={featuredImage}
                                            alt=""
                                            loading="lazy"
                                        />
                                    </a>
                                )}
                                <div>
                                    <h3 class="text-xl font-bold">
                                        <a
                                            class="post-title-link"
                                            href={`/work/${study.slug}/`}
                                        >
                                            {study.data.title}
                                        </a>
                                    </h3>
                                    {study.data.description && (
                                        <p class="mt-2">
                                            {study.data.description}
                                        </p>
                                    )}
                                </div>
                            </article>
                        );
                    })}
                </div>
            </section>
        )
    }
</Base>
