---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { hasYouTubeEmbed } from "../utils/embeds";
import { getImageMetadata } from "../utils/image-metadata";
import { getEntrySlug } from "../utils/content";
import { getFeaturedImage } from "../utils/images";
export async function getStaticPaths() {
    const pages = await getCollection("pages", ({ data }) => !data.draft);
    return pages.map((page) => ({
        params: { slug: getEntrySlug(page) },
        props: { page },
    }));
}
const { page } = Astro.props;
const pageSlug = getEntrySlug(page);
const { Content } = await render(page);
const pageFeaturedImage = getFeaturedImage(page);
const pageHeroImageMetadata = getImageMetadata(page.data.heroImage);
const pagesWithUpdatedDate = new Set(["about", "work", "uses", "now"]);
const showUpdatedDate =
    pagesWithUpdatedDate.has(pageSlug) && page.data.updatedDate;
const formattedUpdatedDate = page.data.updatedDate?.toLocaleDateString(
    "en-GB",
    {
        day: "numeric",
        month: "long",
        year: "numeric",
    },
);
const caseStudies =
    pageSlug === "work"
        ? (await getCollection("case-studies", ({ data }) => !data.draft)).sort(
              (a, b) =>
                  a.data.order - b.data.order ||
                  b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
          )
        : [];
---

<Base
    title={page.data.title}
    description={page.data.description ||
        `${page.data.title} page for Daniel Marcinkowski.`}
    canonical={`/${pageSlug}/`}
    socialImage={pageFeaturedImage}
    hasYouTubeEmbeds={hasYouTubeEmbed(page.body)}
>
    <article>
        <h1
            class={`text-4xl font-bold ${showUpdatedDate || page.data.heroImage ? "mb-3" : "mb-8"}`}
        >
            {page.data.title}
        </h1>
        {
            showUpdatedDate && (
                <p class="page-updated">Last updated: {formattedUpdatedDate}</p>
            )
        }
        {
            page.data.heroImage && (
                <img
                    class="page-hero-image"
                    src={page.data.heroImage}
                    alt=""
                    width={pageHeroImageMetadata?.width}
                    height={pageHeroImageMetadata?.height}
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                />
            )
        }
        <div class="prose prose-zinc dark:prose-invert"><Content /></div>
    </article>
    {
        pageSlug === "work" && caseStudies.length > 0 && (
            <section class="case-section">
                <h2 class="text-2xl font-bold">Case studies</h2>
                <div class="case-list">
                    {caseStudies.map((study) => {
                        const featuredImage = getFeaturedImage(study);
                        const featuredImageMetadata =
                            getImageMetadata(featuredImage);
                        return (
                            <article
                                class={`post-card ${featuredImage ? "with-image" : ""}`}
                            >
                                {featuredImage && (
                                    <a href={`/work/${getEntrySlug(study)}/`}>
                                        <img
                                            class="post-thumb"
                                            src={featuredImage}
                                            alt=""
                                            width={featuredImageMetadata?.width}
                                            height={
                                                featuredImageMetadata?.height
                                            }
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    </a>
                                )}
                                <div>
                                    <h3 class="text-xl font-bold">
                                        <a
                                            class="post-title-link"
                                            href={`/work/${getEntrySlug(study)}/`}
                                        >
                                            {study.data.title}
                                        </a>
                                    </h3>
                                    {study.data.description && (
                                        <p class="mt-2">
                                            {study.data.description}
                                        </p>
                                    )}
                                </div>
                            </article>
                        );
                    })}
                </div>
            </section>
        )
    }
</Base>
