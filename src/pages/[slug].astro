---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { getFeaturedImage } from "../utils/images";
export async function getStaticPaths() {
    const pages = await getCollection("pages", ({ data }) => !data.draft);
    return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await page.render();
const caseStudies =
    page.slug === "work"
        ? (await getCollection("case-studies", ({ data }) => !data.draft)).sort(
              (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
          )
        : [];
---

<Base
    title={page.data.title}
    description={page.data.description ||
        `${page.data.title} page for Daniel Marcinkowski.`}
    canonical={`/${page.slug}/`}
>
    <article>
        <h1 class="mb-8 text-4xl font-bold">{page.data.title}</h1>
        <div class="prose prose-zinc dark:prose-invert"><Content /></div>
    </article>
    {
        page.slug === "work" && caseStudies.length > 0 && (
            <section class="case-section">
                <h2 class="text-2xl font-bold">Case studies</h2>
                <div class="case-list">
                    {caseStudies.map((study) => {
                        const featuredImage = getFeaturedImage(study);
                        return (
                            <article
                                class={`post-card ${featuredImage ? "with-image" : ""}`}
                            >
                                {featuredImage && (
                                    <a href={`/work/${study.slug}/`}>
                                        <img
                                            class="post-thumb"
                                            src={featuredImage}
                                            alt=""
                                            loading="lazy"
                                        />
                                    </a>
                                )}
                                <div>
                                    <h3 class="text-xl font-bold">
                                        <a
                                            class="post-title-link"
                                            href={`/work/${study.slug}/`}
                                        >
                                            {study.data.title}
                                        </a>
                                    </h3>
                                    {study.data.description && (
                                        <p class="mt-2">
                                            {study.data.description}
                                        </p>
                                    )}
                                </div>
                            </article>
                        );
                    })}
                </div>
            </section>
        )
    }
</Base>
