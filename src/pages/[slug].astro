---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await page.render();
---
<Base title={page.data.title} description={page.data.description || `${page.data.title} page for Daniel Marcinkowski.`} canonical={`/${page.slug}/`}>
  <article>
    <h1 class="mb-8 text-4xl font-bold">{page.data.title}</h1>
    <div class="prose prose-zinc dark:prose-invert"><Content /></div>
  </article>
</Base>
