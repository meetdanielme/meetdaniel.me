---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getFeaturedImage } from "../../utils/images";

export async function getStaticPaths() {
    const studies = await getCollection("case-studies", ({ data }) => !data.draft);
    return studies.map((study) => ({
        params: { slug: study.slug },
        props: { study },
    }));
}

const { study } = Astro.props;
const { Content } = await study.render();
const featuredImage = getFeaturedImage(study);
const metadata = [
    {
        label: "Location",
        value: study.data.location,
        icon: "ri-map-pin-line",
    },
    {
        label: "Team size",
        value: study.data.teamSize,
        icon: "ri-team-line",
    },
    {
        label: "Period",
        value: study.data.period,
        icon: "ri-calendar-line",
    },
].filter((item) => item.value);
---

<Base
    title={study.data.title}
    description={study.data.description ||
        `Case study by Daniel Marcinkowski: ${study.data.title}`}
    canonical={`/work/${study.slug}/`}
    socialImage={featuredImage}
>
    <article>
        <p>
            <a class="back-link" href="/work/"
                ><i class="ri-arrow-left-line" aria-hidden="true"></i>Back to
                Work</a
            >
        </p>
        <header class="case-study-header">
            <h1 class="mt-2 text-4xl font-bold leading-tight">
                {study.data.title}
            </h1>
            {
                study.data.description && (
                    <p class="mt-4 text-xl text-zinc-700 dark:text-zinc-300">
                        {study.data.description}
                    </p>
                )
            }
            {
                featuredImage && (
                    <img
                        class="case-hero-image mt-8"
                        src={featuredImage}
                        alt=""
                    />
                )
            }
        </header>
        {
            metadata.length > 0 && (
                <dl class="case-detail-grid">
                    {metadata.map((item) => (
                        <div>
                            <dt>
                                <i class={item.icon} aria-hidden="true" />
                                <span>{item.label}</span>
                            </dt>
                            <dd>{item.value}</dd>
                        </div>
                    ))}
                </dl>
            )
        }
        {
            study.data.metrics.length > 0 && (
                <dl class="metrics-grid">
                    {study.data.metrics.map((metric) => (
                        <div>
                            <dt>{metric.label}</dt>
                            <dd>{metric.value}</dd>
                        </div>
                    ))}
                </dl>
            )
        }
        <div class="prose prose-zinc dark:prose-invert"><Content /></div>
    </article>
</Base>
