---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The requested page could not be found.">
  <h1 class="text-4xl font-bold">Page not found</h1>
  <p class="mt-4">This page does not exist, or it may have moved during the WordPress to Astro migration.</p>
  <a class="btn btn-primary mt-6" href="/">Go home</a>
</Base>
