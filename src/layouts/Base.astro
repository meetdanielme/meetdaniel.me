---
import "remixicon/fonts/remixicon.css";
import "lite-youtube-embed/src/lite-yt-embed.css";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import SearchBox from "../components/SearchBox.astro";
const {
    title = "Daniel Marcinkowski",
    description = "Personal website and writing by Daniel Marcinkowski about technology, productivity, marketing, university, and humane digital life.",
    canonical = Astro.url.pathname,
} = Astro.props;
const url = new URL(canonical, Astro.site);
const currentPath = Astro.url.pathname;
const nav = [
    { href: "/", label: "Home", icon: "ri-home-5-line" },
    { href: "/blog/", label: "Blog", icon: "ri-quill-pen-line" },
    { href: "/about/", label: "About", icon: "ri-user-3-line" },
    { href: "/work/", label: "Work", icon: "ri-briefcase-4-line" },
    { href: "/uses/", label: "Uses", icon: "ri-tools-line" },
    { href: "/now/", label: "Now", icon: "ri-time-line" },
];
const socials = [
    {
        href: "https://www.linkedin.com/in/meetdanielme/",
        label: "LinkedIn",
        icon: "ri-linkedin-box-fill",
    },
    {
        href: "https://x.com/meetdanielme",
        label: "Twitter",
        icon: "ri-twitter-fill",
    },
    {
        href: "https://github.com/meetdanielme",
        label: "GitHub",
        icon: "ri-github-fill",
    },
    {
        href: "https://bsky.app/profile/meetdaniel.me",
        label: "Bluesky",
        icon: "ri-bluesky-fill",
    },
    {
        href: "https://www.threads.net/@meetdaniel.me",
        label: "Threads",
        icon: "ri-threads-fill",
    },
    { href: "/rss.xml", label: "RSS", icon: "ri-rss-line" },
];
const contactHref = "mailto:hey@meetdaniel.me";
const profileImage = "/images/profile/daniel-marcinkowski-profile-picture.jpg";
---

<html lang="en-GB">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <script is:inline>
            (() => {
                const saved = localStorage.getItem("theme");
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                document.documentElement.dataset.theme =
                    saved || (prefersDark ? "dark" : "light");
            })();
        </script>
        <title>
            {
                title === "Daniel Marcinkowski"
                    ? title
                    : `${title} · Daniel Marcinkowski`
            }
        </title>
        <meta name="description" content={description} />
        <link rel="canonical" href={url.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={url.href} />
        <meta property="og:type" content="website" />
        <link rel="icon" href="/icon-1024.png" type="image/png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Daniel Marcinkowski RSS"
            href="/rss.xml"
        />
    </head>
    <body>
        <div class="site-shell">
            <header class="mobile-header">
                <button
                    id="menu-open"
                    class="icon-button"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                    aria-label="Open menu"
                    ><i class="ri-menu-line" aria-hidden="true"></i></button
                >
                <a href="/" class="site-name-link font-bold"
                    >Daniel Marcinkowski</a
                >
                <button
                    class="icon-button theme-toggle"
                    type="button"
                    aria-label="Toggle colour theme"
                    ><i class="ri-moon-line" data-theme-icon aria-hidden="true"
                    ></i></button
                >
            </header>
            <div
                id="mobile-menu"
                class="mobile-menu hidden"
                role="dialog"
                aria-modal="true"
                aria-label="Site navigation"
            >
                <div class="mobile-menu-header">
                    <button
                        id="menu-close"
                        class="icon-button"
                        aria-label="Close menu"
                        ><i class="ri-close-line" aria-hidden="true"
                        ></i></button
                    >
                    <a
                        href="/"
                        class="mobile-menu-title site-name-link font-bold"
                        >Daniel Marcinkowski</a
                    >
                    <span class="mobile-menu-spacer" aria-hidden="true"></span>
                </div>
                <div class="mt-6"><SearchBox id="mobile-search" /></div>
                <nav class="mt-10 grid gap-5 text-2xl">
                    {
                        nav.map((item) => (
                            <a
                                class="nav-link mobile-menu-link"
                                href={item.href}
                            >
                                <i class={item.icon} aria-hidden="true" />
                                {item.label}
                            </a>
                        ))
                    }
                </nav>
                <div
                    class="mt-10 border-t border-zinc-200 pt-6 dark:border-zinc-800"
                >
                    <div class="flex flex-wrap gap-3">
                        {
                            socials.map((item) => (
                                <a
                                    class="social-link mobile-menu-link"
                                    href={item.href}
                                    aria-label={item.label}
                                >
                                    <i class={item.icon} aria-hidden="true" />
                                </a>
                            ))
                        }
                    </div>
                    <a
                        class="btn btn-secondary mobile-menu-link mt-6"
                        href={contactHref}
                        ><i class="ri-mail-line" aria-hidden="true"></i>Contact
                        Me</a
                    >
                </div>
            </div>
            <div class="site-grid">
                <aside class="sidebar">
                    <div class="profile-block">
                        <img
                            class="profile-image"
                            src={profileImage}
                            alt="Portrait of Daniel Marcinkowski"
                        />
                        <a href="/" class="profile-name"
                            >Daniel Marcinkowski</a
                        >
                    </div>
                    <SearchBox id="desktop-search" />
                    <nav class="sidebar-nav mt-8 grid gap-2 text-base">
                        {
                            nav.map((item) => (
                                <a
                                    href={item.href}
                                    class="nav-link"
                                    aria-current={
                                        currentPath === item.href
                                            ? "page"
                                            : undefined
                                    }
                                >
                                    <i class={item.icon} aria-hidden="true" />
                                    {item.label}
                                </a>
                            ))
                        }
                    </nav>
                    <div
                        class="sidebar-socials mt-8 flex flex-wrap gap-1 border-t border-zinc-300 pt-6 dark:border-zinc-800"
                    >
                        {
                            socials.map((item) => (
                                <a
                                    class="social-link"
                                    href={item.href}
                                    aria-label={item.label}
                                >
                                    <i class={item.icon} aria-hidden="true" />
                                </a>
                            ))
                        }
                    </div>
                    <div class="sidebar-footer">
                        <a class="btn btn-secondary" href={contactHref}
                            ><i class="ri-mail-line" aria-hidden="true"
                            ></i>Contact Me</a
                        >
                    </div>
                </aside>
                <main class="max-w-[760px]">
                    <div class="hidden justify-end md:flex">
                        <button
                            class="icon-button theme-toggle"
                            type="button"
                            aria-label="Toggle colour theme"
                            ><i
                                class="ri-moon-line"
                                data-theme-icon
                                aria-hidden="true"></i></button>
                    </div><slot />
                    <footer class="site-footer">
                        <hr />
                        <p>
                            © 2026 Daniel Marcinkowski · <a
                                href="/privacy-policy/">Privacy Policy</a
                            >
                        </p>
                    </footer>
                </main>
            </div>
        </div>
        <dialog
            class="image-lightbox"
            data-image-lightbox
            aria-label="Expanded image"
        >
            <button
                class="image-lightbox-close icon-button"
                type="button"
                data-image-lightbox-close
                aria-label="Close expanded image"
                ><i class="ri-close-line" aria-hidden="true"></i></button
            >
            <figure>
                <img data-image-lightbox-img alt="" />
                <figcaption data-image-lightbox-caption></figcaption>
            </figure>
        </dialog>
        <Analytics />
        <SpeedInsights />
        <script>
            import "lite-youtube-embed";
        </script>
        <script is:inline>
            const openButton = document.getElementById("menu-open");
            const closeButton = document.getElementById("menu-close");
            const menu = document.getElementById("mobile-menu");
            const links = Array.from(
                document.querySelectorAll(".mobile-menu-link"),
            );
            const openMenu = () => {
                menu?.classList.remove("hidden");
                document.body.classList.add("menu-open");
                openButton?.setAttribute("aria-expanded", "true");
                closeButton?.focus();
            };
            const closeMenu = () => {
                menu?.classList.add("hidden");
                document.body.classList.remove("menu-open");
                openButton?.setAttribute("aria-expanded", "false");
                openButton?.focus();
            };
            openButton?.addEventListener("click", openMenu);
            closeButton?.addEventListener("click", closeMenu);
            links.forEach((link) =>
                link.addEventListener("click", () => {
                    menu?.classList.add("hidden");
                    document.body.classList.remove("menu-open");
                }),
            );
            document.addEventListener("keydown", (event) => {
                if (
                    event.key === "Escape" &&
                    !menu?.classList.contains("hidden")
                )
                    closeMenu();
            });
            const setTheme = (theme) => {
                document.documentElement.dataset.theme = theme;
                localStorage.setItem("theme", theme);
                document
                    .querySelectorAll("[data-theme-icon]")
                    .forEach((icon) => {
                        icon.className =
                            theme === "dark" ? "ri-sun-line" : "ri-moon-line";
                    });
            };
            setTheme(document.documentElement.dataset.theme || "light");
            document
                .querySelectorAll(".theme-toggle")
                .forEach((button) =>
                    button.addEventListener("click", () =>
                        setTheme(
                            document.documentElement.dataset.theme === "dark"
                                ? "light"
                                : "dark",
                        ),
                    ),
                );
            const lightbox = document.querySelector("[data-image-lightbox]");
            const lightboxImage = document.querySelector(
                "[data-image-lightbox-img]",
            );
            const lightboxCaption = document.querySelector(
                "[data-image-lightbox-caption]",
            );
            const lightboxClose = document.querySelector(
                "[data-image-lightbox-close]",
            );
            const getCaption = (image) => {
                const figureCaption = image
                    .closest("figure")
                    ?.querySelector("figcaption")?.textContent;
                return figureCaption?.trim() || image.alt || "";
            };
            const openLightbox = (image) => {
                if (!lightbox || !lightboxImage || !lightboxCaption) return;
                lightboxImage.src = image.currentSrc || image.src;
                lightboxImage.alt = image.alt || "";
                const caption = getCaption(image);
                lightboxCaption.textContent = caption;
                lightboxCaption.hidden = !caption;
                lightbox.showModal();
                lightboxClose?.focus();
            };
            document
                .querySelectorAll(
                    ".prose img, .case-hero-image, .page-hero-image, .post-hero-image",
                )
                .forEach((image) => {
                    if (image.closest("a")) return;
                    image.dataset.lightboxImage = "true";
                    image.tabIndex = 0;
                    image.setAttribute("role", "button");
                    image.setAttribute(
                        "aria-label",
                        image.alt
                            ? `Expand image: ${image.alt}`
                            : "Expand image",
                    );
                    image.addEventListener("click", () => openLightbox(image));
                    image.addEventListener("keydown", (event) => {
                        if (event.key !== "Enter" && event.key !== " ") return;
                        event.preventDefault();
                        openLightbox(image);
                    });
                });
            lightboxClose?.addEventListener("click", () => lightbox?.close());
            lightbox?.addEventListener("click", (event) => {
                if (event.target === lightbox) lightbox.close();
            });
        </script>
    </body>
</html>
