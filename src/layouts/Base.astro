---
import '../styles/global.css';
const { title = 'Daniel Marcinkowski', description = 'Personal website and writing by Daniel Marcinkowski about technology, productivity, marketing, university, and humane digital life.', canonical = Astro.url.pathname } = Astro.props;
const url = new URL(canonical, Astro.site);
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title === 'Daniel Marcinkowski' ? title : `${title} · Daniel Marcinkowski`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title="Daniel Marcinkowski RSS" href="/rss.xml" />
  </head>
  <body>
    <div class="mx-auto grid max-w-[1200px] gap-10 px-6 py-8 md:grid-cols-[220px_1fr] md:px-10">
      <aside class="md:sticky md:top-8 md:h-[calc(100vh-4rem)] md:border-r md:border-zinc-200 md:pr-8 dark:md:border-zinc-800">
        <a href="/" class="block text-lg font-bold">Daniel Marcinkowski</a>
        <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">Student & Creator</p>
        <nav class="mt-8 grid gap-3 text-sm font-semibold">
          <a href="/">Home</a><a href="/about/">About</a><a href="/work/">Work</a><a href="/now/">Now</a><a href="/uses/">Uses</a><a href="/blog/">Blog</a><a href="/rss.xml">Feed</a>
        </nav>
        <footer class="mt-10 text-sm text-zinc-600 dark:text-zinc-400 md:absolute md:bottom-0">
          <p>Cork, Ireland</p>
          <p><a href="mailto:hey@meetdaniel.me">hey@meetdaniel.me</a></p>
          <p>© 2026 Daniel Marcinkowski</p>
        </footer>
      </aside>
      <main class="max-w-[760px]"><slot /></main>
    </div>
  </body>
</html>
