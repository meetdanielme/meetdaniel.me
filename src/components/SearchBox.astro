---
const { id = 'site-search' } = Astro.props;
---
<div class="search-box" data-search-root>
  <label class="sr-only" for={id}>Search</label>
  <div class="search-input-wrap">
    <i class="ri-search-line" aria-hidden="true"></i>
    <input id={id} data-search-input type="search" autocomplete="off" placeholder="Search posts and pages" />
  </div>
  <div class="search-results" data-search-results hidden></div>
</div>
